<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:VisualElement data-source-type="KattenKasteel.FSM.StateMachine, net.kattenkasteel.finite-state-machine.Runtime" style="flex-grow: 1; background-color: rgb(48, 52, 70); flex-shrink: 1; padding-top: 5px; padding-left: 5px; padding-right: 5px; padding-bottom: 5px; border-bottom-width: 2px; border-left-width: 2px; border-top-width: 2px; border-right-width: 2px; border-left-color: rgb(202, 158, 230); border-right-color: rgb(202, 158, 230); border-top-color: rgb(202, 158, 230); border-bottom-color: rgb(202, 158, 230); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;">
        <ui:Label text="State Machine" style="-unity-text-align: upper-center; color: rgb(202, 158, 230); -unity-font-style: bold; font-size: 20px;"/>
        <ui:VisualElement name="" data-source-type="KattenKasteel.FSM.State, net.kattenkasteel.finite-state-machine.Runtime" style="flex-grow: 1; flex-direction: column; justify-content: space-around; align-self: stretch; align-content: stretch; padding-bottom: 0;">
            <uie:ObjectField label="Initial State" binding-path="initialState" allow-scene-objects="true" data-source-type="KattenKasteel.FSM.State, net.kattenkasteel.finite-state-machine.Runtime" data-source-path="" type="KattenKasteel.FSM.State, net.kattenkasteel.finite-state-machine.Runtime" tooltip="The state the state machine starts in" style="color: rgb(198, 208, 245); font-size: 16px;"/>
            <uie:ObjectField label="Active State" binding-path="&lt;ActiveState&gt;k__BackingField" allow-scene-objects="true" data-source-type="KattenKasteel.FSM.State, net.kattenkasteel.finite-state-machine.Runtime" data-source-path="" type="KattenKasteel.FSM.State, net.kattenkasteel.finite-state-machine.Runtime" enabled="false" tooltip="The current state of the state machine" style="color: rgb(198, 208, 245); font-size: 16px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
