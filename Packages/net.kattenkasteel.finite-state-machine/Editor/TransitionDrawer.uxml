<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:VisualElement style="flex-grow: 1; background-color: rgb(48, 52, 70); flex-shrink: 1; padding-top: 5px; padding-left: 5px; padding-right: 5px; padding-bottom: 5px; border-bottom-width: 2px; border-left-width: 2px; border-top-width: 2px; border-right-width: 2px; border-left-color: rgb(202, 158, 230); border-right-color: rgb(202, 158, 230); border-top-color: rgb(202, 158, 230); border-bottom-color: rgb(202, 158, 230); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;">
        <ui:Label text="Transition" style="-unity-text-align: upper-center; color: rgb(202, 158, 230); -unity-font-style: bold; font-size: 20px;"/>
        <ui:VisualElement name="" style="flex-grow: 1; flex-direction: column; justify-content: space-around; align-self: stretch; align-content: center;">
            <ui:VisualElement style="flex-grow: 0; margin-right: 10px; border-right-width: 0; border-right-color: rgb(0, 0, 0); flex-basis: auto;">
                <ui:Label text="Target" style="color: rgb(198, 208, 245);"/>
                <uie:ObjectField label="" type="KattenKasteel.FSM.State, net.kattenkasteel.finite-state-machine.Runtime" binding-path="&lt;Target&gt;k__BackingField" enabled="true" style="color: rgb(198, 208, 245);"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; flex-shrink: 1;">
                <ui:Label text="Conditions" style="-unity-text-outline-color: rgb(0, 0, 0); color: rgb(198, 208, 245);"/>
                <ui:ListView binding-path="conditions" data-source-type="KattenKasteel.FSM.Condition, net.kattenkasteel.finite-state-machine.Runtime" show-border="true" horizontal-scrolling="false" show-foldout-header="false" show-add-remove-footer="true" show-bound-collection-size="false" binding-source-selection-mode="AutoAssign" style="align-content: flex-end; justify-content: flex-end; margin-left: 0; -unity-background-scale-mode: stretch-to-fill; padding-right: 10px; padding-left: 5px; flex-grow: 1;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
