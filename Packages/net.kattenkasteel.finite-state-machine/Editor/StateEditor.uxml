<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:VisualElement data-source-type="KattenKasteel.FSM.State, net.kattenkasteel.finite-state-machine.Runtime" style="flex-grow: 1; background-color: rgb(48, 52, 70); flex-shrink: 1; padding-top: 5px; padding-left: 5px; padding-right: 5px; padding-bottom: 5px; border-bottom-width: 2px; border-left-width: 2px; border-top-width: 2px; border-right-width: 2px; border-left-color: rgb(202, 158, 230); border-right-color: rgb(202, 158, 230); border-top-color: rgb(202, 158, 230); border-bottom-color: rgb(202, 158, 230); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;">
        <ui:Label text="State" style="-unity-text-align: upper-center; color: rgb(202, 158, 230); -unity-font-style: bold; font-size: 20px;"/>
        <ui:VisualElement name="" data-source-type="KattenKasteel.FSM.State, net.kattenkasteel.finite-state-machine.Runtime" style="flex-grow: 1; flex-direction: column; justify-content: space-around; align-self: stretch; align-content: stretch; padding-bottom: 0;">
            <ui:TextField label="State Name" placeholder-text="enter state name..." binding-path="&lt;StateName&gt;k__BackingField" data-source-path="" style="color: rgb(198, 208, 245); font-size: 16px;"/>
            <uie:PropertyField binding-path="&lt;SceneIndex&gt;k__BackingField" label="Scene Index" style="color: rgb(198, 208, 245); font-size: 16px; flex-grow: 0; -unity-text-auto-size: none; -unity-text-generator: standard; scale: 1.14 1.14; padding-top: 0; padding-bottom: 0; padding-left: 23px; padding-right: 26px;"/>
            <ui:Toggle label="Is Parent" binding-path="&lt;IsParent&gt;k__BackingField" name="IsParent" style="flex-wrap: wrap-reverse; color: rgb(198, 208, 245); font-size: 16px;"/>
            <ui:VisualElement name="ParentSettings" style="flex-grow: 0; margin-top: 25px; visibility: visible; display: flex;">
                <ui:Label text="Parent State Settings" style="-unity-text-align: upper-center; font-size: 18px; -unity-font-style: bold; color: rgb(202, 158, 230);"/>
                <ui:ListView binding-path="&lt;Children&gt;k__BackingField" show-add-remove-footer="true" show-border="true" header-title="Child States" show-foldout-header="true" style="padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; font-size: 16px; color: rgb(198, 208, 245);"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
